# ============================================================
# AutoPredict AI - Variáveis de Ambiente
# ============================================================
# INSTRUÇÕES:
#   1. Renomeie este arquivo para .env
#   2. Ajuste as senhas (especialmente em produção!)
#   3. NUNCA commite o .env no Git
# ============================================================

# --- MinIO (Data Lake) ---
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin123

# --- PostgreSQL (Banco de Metadados) ---
POSTGRES_USER=autopredict
POSTGRES_PASSWORD=autopredict123
POSTGRES_DB=autopredict

# --- Ollama (Modelo LLM Local) ---
# Opções: llama3.2:1b (rápido), llama3.2:3b (balanço), mistral:7b (melhor qualidade)
# Quanto menor o modelo, mais rápido mas menos preciso
OLLAMA_MODEL=llama3.2:3b

# --- Cloud LLM API Keys (Opcional) ---
# Configure para usar modelos online além dos locais

# Groq (GRATUITO! ⚡ Super Rápido) - https://console.groq.com
# Cadastre-se grátis, vá em "API Keys" e crie uma nova chave
# Modelos: Llama 3.1 70B, Mixtral 8x7B, Gemma 7B
GROQ_API_KEY=

# OpenAI (Pago) - https://platform.openai.com
# Modelos: GPT-4o, GPT-4, GPT-3.5 Turbo
OPENAI_API_KEY=

# Anthropic (Pago) - https://console.anthropic.com
# Modelos: Claude 3 Opus, Sonnet, Haiku
ANTHROPIC_API_KEY=

# ⭐ RECOMENDAÇÃO: Use Groq (100% gratuito e extremamente rápido!)
# Passo a passo:
#   1. Acesse: https://console.groq.com
#   2. Crie conta grátis (só precisa de email)
#   3. Clique em "Create API Key"
#   4. Copie a chave (começa com gsk_...)
#   5. Cole acima: GROQ_API_KEY=gsk_...
#   6. Reinicie: docker compose restart api frontend
#   7. Pronto! Agora você tem acesso a Llama 3.1 70B gratuitamente! 🎉
